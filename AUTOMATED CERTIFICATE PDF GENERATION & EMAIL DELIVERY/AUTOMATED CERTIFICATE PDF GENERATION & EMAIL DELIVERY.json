        "jsCode": "let items = $input.all();\n\nlet html = `\n  <html>\n    <head>\n      <title>Customer Feddback report</title>\n    </head>\n    <body>\n`;\n\nfor(let item of items)\n{\n  const name = item.json.Name;\n  const email = item.json.Email;\n  const feedabck = item.json.Feedback;\n\n  html += `<p>Customer Name : ${name}</p>`;\n  html += `<p>Customer Email : ${email}</p>`;\n  html += `<p>Feedback : ${feedabck}</p>`;\n  html += `<hr>`;\n}\n\nhtml += `\n</body>\n</html>\n`\n\nreturn[\n  {\n    json : {\n      html : html\n    }\n  }\n]"
      },
